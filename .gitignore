# build
/bin/
/gen/
*.test

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# experiment output -- raw logs are append-only and NOT committed
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/experiments/manifests/*.json
/paper/generated_tables/*.tex
/paper/figures/fig3_timeline.pdf
/paper/figures/fig4_main.pdf
!/paper/figures/.gitkeep
results_long.csv
summary.csv
statistical_tests.csv

# local
.DS_Store
.env
_to_delete/

# latex build artifacts
paper/*.aux
paper/*.log
paper/*.blg
paper/*.bbl
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/main.pdf

# Build output: rebuilt by `make build`, never evidence.
bin/

# run logs -- same rule as data/raw: append-only, not committed
/logs/*
!/logs/.gitkeep

# latex build artifacts
/paper/main.pdf
/paper/main.bbl
/paper/*.aux
/paper/*.blg
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.log
/paper/*.synctex.gz

# latex scratch
/paper/*.tmp

# Derived by scripts/deploy_to_host.sh on every deploy; never committed, so it
# cannot go stale (it once sat at protocol-0.9 for a week of runs).
SOURCE_REVISION

# The manuscript. This repository is the reproducibility artifact: the code, the
# protocol with its amendment log, the analysis that produces every reported
# figure, the tests and the audit. The manuscript itself -- prose, figures,
# bibliography, the supplement, the LaTeX build -- is not needed to reproduce
# anything, and it is the part that can be scooped before the paper is accepted.
# It is added here together with the camera-ready version, on acceptance.
/paper/

# The submission folder is a generated copy of the manuscript; it is rebuilt by
# scripts/make_submission_folder.sh and follows paper/ out of the repository.
/paper/submission-ready/
/paper/submission-ready-keep/

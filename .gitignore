# build
/bin/
/gen/
*.test

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# experiment output -- raw logs are append-only and NOT committed
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/experiments/manifests/*.json
/paper/generated_tables/*.tex
/paper/figures/fig3_timeline.pdf
/paper/figures/fig4_main.pdf
!/paper/figures/.gitkeep
results_long.csv
summary.csv
statistical_tests.csv

# local
.DS_Store
.env
_to_delete/

# latex build artifacts
paper/*.aux
paper/*.log
paper/*.blg
paper/*.bbl
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/main.pdf

# Build output: rebuilt by `make build`, never evidence.
bin/

# run logs -- same rule as data/raw: append-only, not committed
/logs/*
!/logs/.gitkeep

